# Variáveis opcionais para docker-compose.prod.yml.
# A imagem padrão é ghcr.io/eduhsilva/admin-ui:latest.
IMAGE_TAG=latest

# Nome da rede externa criada pela stack microservices.
EHS_MICROSERVICES_NETWORK=microservices_backend

# Para usar uma imagem diferente, informe o nome completo:
# ADMIN_UI_IMAGE=ghcr.io/eduhsilva/admin-ui:latest
